<view class="container">
  <view class="tabs">
    <view 
      class="tab-item {{currentTab === 'all' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="all"
    >全部</view>
    <view 
      class="tab-item {{currentTab === 'ongoing' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="ongoing"
    >进行中</view>
    <view 
      class="tab-item {{currentTab === 'completed' ? 'active' : ''}}" 
      bindtap="switchTab" 
      data-tab="completed"
    >已完成</view>
  </view>

  <view class="order-list">
    <view 
      class="order-card" 
      wx:for="{{orderList}}" 
      wx:key="id" 
      bindtap="goToOrderDetail" 
      data-order-id="{{item.id}}"
    >
      <view class="order-header">
        <view class="order-title">{{item.taskTitle}}</view>
        <view class="order-status">{{getStatusText(item.status)}}</view>
      </view>
      <view class="order-info">
        <view class="order-commission">¥{{item.commission}}</view>
        <view class="order-time">{{formatTime(item.createdAt)}}</view>
      </view>
      <view class="order-actions" wx:if="[[item.status === 1 || item.status === 2]]">
        <view class="action-btn" bindtap="goToSubmit" data-order-id="{{item.id}}">提交任务</view>
      </view>
      <view class="order-actions" wx:if="[[item.status === 5]]">
        <view class="action-btn warning" bindtap="goToRetry" data-order-id="{{item.id}}">修改重提</view>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{orderList.length === 0}}">
    <text>暂无任务</text>
  </view>
</view>