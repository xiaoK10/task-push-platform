.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.tabs {
  display: flex;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
}

.tab-item.active {
  background-color: #4a90d9;
  color: #fff;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card {
  background-color: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.order-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.order-status {
  padding: 8rpx 20rpx;
  background-color: #f0f4f8;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #4a90d9;
}

.order-info {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #999;
}

.order-commission {
  color: #e74c3c;
  font-weight: 500;
}

.order-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 72rpx;
  background-color: #4a90d9;
  color: #fff;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.action-btn.warning {
  background-color: #ff9800;
}

.empty {
  text-align: center;
  padding: 100rpx;
  color: #999;
}