<view class="container">
  <view class="section">
    <view class="section-title">申诉类型</view>
    <view class="type-options">
      <view 
        class="type-option {{disputeType === 1 ? 'active' : ''}}" 
        bindtap="selectType" 
        data-type="1"
      >雇主恶意驳回</view>
      <view 
        class="type-option {{disputeType === 2 ? 'active' : ''}}" 
        bindtap="selectType" 
        data-type="2"
      >无故扣佣金</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">申诉内容</view>
    <textarea 
      class="dispute-textarea" 
      placeholder="请详细描述申诉原因和情况..."
      bindinput="onContentInput"
    />
  </view>

  <view class="section">
    <view class="section-title">举证材料</view>
    <view class="upload-area">
      <view class="upload-btn" bindtap="chooseImage">
        <text>+ 添加图片</text>
      </view>
    </view>
  </view>

  <view class="submit-btn" bindtap="handleSubmit">提交申诉</view>
</view>